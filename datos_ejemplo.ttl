:Deploy_03 a :Despliegue ;
    :perteneceAProyecto :Proj_Biblioteca ;
    :desplegadoEn :Amb_Produccion ;
    :versionDesplegada "v1.9.3" ;
    :estadoDespliegue "Fallido" ;
    :fechaDespliegue "2026-11-12T22:15:00"^^xsd:dateTime ;
